#include "libft.h"
#include <stdio.h>

int main(void) {
    char *s = ft_strdup("Hola 42");
    if (s) {
        printf("%s\n", s);
        free(s);
    }

    int arr[5];
    ft_bzero(arr, sizeof(arr));
    for (int i = 0; i < 5; i++)
        printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
Este ejemplo muestra la utilización de funciones de cadenas, memoria y duplicación de strings de manera sencilla.

